# Runs deploy/autodeploy.sh once; started every few minutes by
# aegis-autodeploy.timer. Assumes the repository is cloned to
# /home/ubuntu/aegis-test and the ubuntu user is in the docker group.
#
# To deploy a branch other than main:
#   sudo systemctl edit aegis-autodeploy.service
# and add:
#   [Service]
#   Environment=AUTODEPLOY_BRANCH=the-branch

[Unit]
Description=Deploy AegisTest when its branch moves
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=ubuntu
Environment=AUTODEPLOY_BRANCH=main
ExecStart=/home/ubuntu/aegis-test/deploy/autodeploy.sh
# A first build on a small instance takes several minutes.
TimeoutStartSec=30min
