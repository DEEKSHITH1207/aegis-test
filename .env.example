# Copy to .env and adjust. Never commit the real .env.

# --- Django ---
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LOG_LEVEL=INFO
DJANGO_TIME_ZONE=UTC
# Page size for list endpoints.
API_PAGE_SIZE=50

# --- PostgreSQL ---
POSTGRES_DB=aegis
POSTGRES_USER=aegis
POSTGRES_PASSWORD=aegis
# "postgres" under docker compose, "localhost" when running Django on the host.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Redis / Celery ---
# "redis://redis:6379/0" under docker compose.
REDIS_URL=redis://localhost:6379/0
# Optional: default to REDIS_URL when unset.
# CELERY_BROKER_URL=
# CELERY_RESULT_BACKEND=

# --- Test execution ---
# Run Celery tasks inside the request instead of on a worker (no worker needed).
# CELERY_TASK_ALWAYS_EAGER=False
EXECUTOR_TIMEOUT_SECONDS=10
EXECUTOR_MAX_RESPONSE_BYTES=1048576
EXECUTOR_VERIFY_TLS=True
# Comma-separated hosts runs may call; empty allows any. Set this whenever the
# AegisTest API is reachable by anyone but you. ".example.com" allows subdomains.
EXECUTOR_ALLOWED_HOSTS=

# --- LLM analysis ---
# Off by default: an analysis sends a run's findings and evidence (request and
# response bodies from the API under test) to Anthropic, and costs money.
LLM_ANALYSIS_ENABLED=False
# Read by the Anthropic SDK. Never commit a real key.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5
# low | medium | high | xhigh | max
LLM_EFFORT=high
LLM_REFUSAL_FALLBACK=True
LLM_FINDINGS_PER_REQUEST=20
LLM_MAX_FINDINGS=200
LLM_TIMEOUT_SECONDS=600
LLM_MAX_RETRIES=3
