# Production settings for docker-compose.prod.yml.
# On the server: cp .env.prod.example .env, fill in every value, never commit it.

# --- Front door (Caddy) ---
# A domain pointing at this server gets HTTPS automatically. ":80" serves plain
# HTTP on the server's IP; use it only for a first test, since the shared
# password then crosses the network unencrypted.
SITE_ADDRESS=aegis.example.com
BASIC_AUTH_USER=team
# A bcrypt hash, never the password itself. Generate it with:
#   docker run --rm caddy:2.8-alpine caddy hash-password --plaintext 'the-password'
# Keep the single quotes: the hash contains "$", which docker compose would
# otherwise try to expand.
BASIC_AUTH_HASH='$2a$14$replace.with.the.output.of.hash-password'

# --- Django ---
# Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# The domain above (and the server's IP if you test on it).
DJANGO_ALLOWED_HOSTS=aegis.example.com
DJANGO_LOG_LEVEL=INFO
DJANGO_TIME_ZONE=UTC
API_PAGE_SIZE=50

# --- PostgreSQL ---
POSTGRES_DB=aegis
POSTGRES_USER=aegis
# Long and random; nothing outside the server can reach the database.
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# --- Test execution ---
EXECUTOR_TIMEOUT_SECONDS=10
EXECUTOR_MAX_RESPONSE_BYTES=1048576
EXECUTOR_VERIFY_TLS=True
# Hosts runs may call. Set this on a shared server: list your staging and test
# hosts; ".staging.example.com" allows every subdomain.
EXECUTOR_ALLOWED_HOSTS=

# --- LLM analysis (off; it costs money) ---
LLM_ANALYSIS_ENABLED=False
# ANTHROPIC_API_KEY=
