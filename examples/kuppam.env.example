# Setup values for examples/kuppam-trip-schedule.rules.yaml.
# Copy to examples/kuppam.env (git-ignored) and fill in real values.
# They are read at run time and never stored by AegisTest.

# Login for the Kuppam backend (an AE account).
AE_USERNAME=
AE_PASSWORD=

# An MPDO-approved water requirement whose supply period covers today-4d..today+3d.
WATER_REQUIREMENT_ID=
# A driver mapped to that habitation's gram panchayat.
DRIVER_ID=
# That driver's tanker owner.
WATER_SUPPLIER_ID=
